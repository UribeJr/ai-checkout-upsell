# Copy this file to .env and fill in the values. Never commit .env.
# SHOPIFY_API_KEY and SHOPIFY_API_SECRET are provided by `shopify app dev`.

# Offline AI enrichment and relationships (never called at checkout)
OPENAI_API_KEY=
OPENAI_MODEL=

# Offer policy (optional; these are the defaults)
OFFER_DISCOUNT_PERCENT=15
OFFER_MAX_ORDER_RATIO=1
